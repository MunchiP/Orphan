  m_TableData:
  - m_Id: 11486208000
    m_Localized: Este es un buen lugar para recolectar pureza.
    m_Metadata:
      m_Items: []
  - m_Id: 951408762880
    m_Localized: Usa tu habilidad de balanceo.
    m_Metadata:
      m_Items: []
  - m_Id: 969058394112
    m_Localized: "\xBFQu\xE9 suceder\xE1 cuando se acabe la pureza?"
    m_Metadata:
      m_Items: []
  - m_Id: 985332293632
    m_Localized: "Hay zonas venenosas por ac\xE1, ten cuidado."
    m_Metadata:
      m_Items: []
  - m_Id: 1057109417984
    m_Localized: "El ascensor es la \xFAnica forma de salir de esta cueva."
    m_Metadata:
      m_Items: []
  - m_Id: 1014663061504
    m_Localized: "Con esto bastar\xE1 para otra semana en el orfanato"
